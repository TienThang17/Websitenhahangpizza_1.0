@{
    ViewBag.Title = "Thu ngân";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@model System.Collections.Generic.List<NhaHangPizza.Models.DonHang>

<div class="container-fluid px-3 py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="page-title mb-0"><i class="bi bi-cash-stack me-2"></i>Thu ngân</h2>
        <a href="@Url.Action("Bep", "DonHang")" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Bếp
        </a>
    </div>

    @if (TempData["LoiThuNgan"] != null)
    {
        <div class="alert alert-danger">@TempData["LoiThuNgan"]</div>
    }
    @if (TempData["KetQuaThuNgan"] != null)
    {
        var kq = TempData["KetQuaThuNgan"] as NhaHangPizza.ViewModels.KetQuaThanhToanViewModel;
        if (kq != null)
        {
            <div class="alert alert-success">
                ✅ Đã thu tiền thành công! Tiền thừa: <strong>@kq.TienThua?.ToString("N0")đ</strong>
            </div>
        }
    }

    @if (Model == null || Model.Count == 0)
    {
        <div class="text-center py-5 text-muted">
            <div class="fs-1">✅</div>
            <h4 class="mt-2">Không có đơn hàng nào đang chờ thanh toán</h4>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var don in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card shadow-sm">
                        <div class="card-header bg-warning text-dark d-flex justify-content-between">
                            <strong>Bàn @don.SoBan</strong>
                            <span>Đơn #@don.MaDonHang</span>
                        </div>
                        <div class="card-body">
                            <div class="fs-4 fw-bold text-pizza text-center mb-3">
                                @don.TongTien.ToString("N0")đ
                            </div>

                            @using (Html.BeginForm("XacNhanTienMat", "ThanhToan", FormMethod.Post))
                            {
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="MaDonHang" value="@don.MaDonHang" />
                                <input type="hidden" name="TongTien" value="@don.TongTien" />

                                <div class="mb-3">
                                    <label class="form-label">Tiền khách đưa (đ)</label>
                                    <input type="number" name="TienKhachDua" class="form-control form-control-lg"
                                           placeholder="Nhập số tiền..." min="@don.TongTien" required
                                           onchange="tinhTra(this, @don.TongTien)" />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Tiền thừa:</label>
                                    <div class="form-control bg-light fs-5 fw-bold" id="tienThua_@don.MaDonHang">—</div>
                                </div>

                                <button type="submit" class="btn btn-success w-100 btn-lg">
                                    <i class="bi bi-check2 me-2"></i>Xác nhận thu tiền
                                </button>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@section scripts {
    <script>
        function tinhTra(input, tongTien) {
            var donHangId = input.closest('.card').querySelector('[name="MaDonHang"]').value;
            var khachDua = parseFloat(input.value) || 0;
            var thua = khachDua - tongTien;
            var el = document.getElementById('tienThua_' + donHangId);
            if (thua >= 0) {
                el.textContent = thua.toLocaleString('vi-VN') + 'đ';
                el.classList.remove('text-danger');
                el.classList.add('text-success');
            } else {
                el.textContent = 'Thiếu ' + Math.abs(thua).toLocaleString('vi-VN') + 'đ';
                el.classList.add('text-danger');
                el.classList.remove('text-success');
            }
        }
    </script>
}
