@{
    ViewBag.Title = "Chờ nhân viên thu tiền";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container text-center py-5">
    <div class="display-1 mb-4">🛎️</div>
    <h2 class="page-title">Đã gọi nhân viên!</h2>
    <p class="lead text-muted mb-4">
        Nhân viên sẽ đến <strong>Bàn @ViewBag.SoBan</strong> để thu tiền ngay.<br />
        Tổng tiền: <strong class="text-pizza fs-4">@((ViewBag.TongTien as decimal?)?.ToString("N0"))đ</strong>
    </p>

    <div class="card mx-auto shadow-sm mb-4" style="max-width:400px;">
        <div class="card-body py-4">
            <div class="fs-1 mb-2">⏳</div>
            <h5>Vui lòng chờ trong giây lát...</h5>
            <p class="text-muted small">Mã đơn hàng: <strong>#@ViewBag.MaDonHang</strong></p>
        </div>
    </div>

    <a href="@Url.Action("Index", "Menu")" class="btn btn-outline-secondary btn-lg">
        <i class="bi bi-arrow-left me-2"></i>Về menu
    </a>
</div>
