<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>@(ViewBag.Title != null ? ViewBag.Title + " - " : "")Nhà Hàng Pizza</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    @Styles.Render("~/Content/css")
    <link href="~/Content/pizza.css" rel="stylesheet" />
</head>
<body class="pizza-app">

    <!-- HEADER CỐ ĐỊNH -->
    <header class="pizza-header fixed-top">
        <div class="container-fluid px-3">
            <div class="row align-items-center g-0">
                <!-- Logo -->
                <div class="col-auto">
                    <a href="@Url.Action("Index", "Menu")" class="pizza-logo d-flex align-items-center text-decoration-none">
                        <span class="logo-icon">🍕</span>
                        <span class="logo-text d-none d-sm-inline">Pizza House</span>
                    </a>
                </div>

                <!-- Stepper điều hướng -->
                <div class="col px-3">
                    @Html.Partial("_Stepper")
                </div>

                <!-- Số bàn + Giỏ hàng -->
                <div class="col-auto d-flex align-items-center gap-2">
                    @{
                        var soBanHeader = Session["SoBan"] as int?;
                    }
                    @if (soBanHeader.HasValue)
                    {
                        <div class="ban-badge">
                            <i class="bi bi-table"></i>
                            <span>Bàn @soBanHeader.Value</span>
                        </div>
                    }

                    <a href="@Url.Action("Index", "GioHang")" class="cart-btn" id="cartBtn">
                        <i class="bi bi-cart3"></i>
                        <span class="cart-count" id="cartCount">0</span>
                        <span class="cart-price d-none d-md-inline" id="cartPrice">0đ</span>
                    </a>
                </div>
            </div>
        </div>
    </header>

    <!-- NỘI DUNG CHÍNH -->
    <main class="pizza-main">
        @RenderBody()
    </main>

    <!-- FOOTER -->
    <footer class="pizza-footer text-center py-2">
        <small class="text-muted">Pizza House &copy; @DateTime.Now.Year — Phục vụ tận tình, hương vị tuyệt vời</small>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @Scripts.Render("~/bundles/jquery")
    <script src="~/Scripts/pizza.js"></script>
    @RenderSection("scripts", required: false)
</body>
</html>
